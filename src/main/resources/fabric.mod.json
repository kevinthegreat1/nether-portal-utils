{
	"schemaVersion": 1,
	"id": "nether-portal-utils",
	"version": "${version}",
	"name": "Nether Portal Utils",
	"description": "Utilities making it easier to work with nether portals",
	"authors": [
		"Kevinthegreat"
	],
	"contact": {
		"homepage": "https://github.com/kevinthegreat1/nether-portal-utils",
		"sources": "https://github.com/kevinthegreat1/nether-portal-utils"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/nether-portal-utils/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "com.kevinthegreat.netherportalutils.NetherPortalUtils",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.kevinthegreat.netherportalutils.client.NetherPortalUtilsClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		{
			"config": "nether-portal-utils.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}